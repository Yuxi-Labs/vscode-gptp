{
  "New GPTP File": {
    "prefix": "gptp-new",
    "body": [
  "{",
  "  \"\\$doctype\": \"gptp\",",
  "  \"schemaVersion\": \"1.2.0\",",
  "  \"promptVersion\": \"1.0.0\",",
  "  \"title\": \"${1:Prompt Name}\",",
  "  \"description\": \"${2:Describe what this prompt does}\",",
  "  \"system\": \"You are a helpful assistant.\",",
  "  \"variables\": [",
  "    {",
  "      \"name\": \"${3:topic}\",",
  "      \"description\": \"${4:The topic or subject}\",",
  "      \"required\": true,",
  "      \"example\": \"${5:climate change}\"",
  "    }",
  "  ],",
  "  \"messages\": [",
  "    {",
  "      \"role\": \"user\",",
  "      \"content\": \"Explain {{topic}} clearly.\"",
  "    }",
  "  ],",
  "  \"output_format\": \"${6|markdown,json,html,plain-text|}\"",
  "}"
    ],
    "description": "Create a full .gptp file scaffold"
  },

  "Insert Message Block": {
    "prefix": "gptp-msg",
    "body": [
      "{",
      "  \"role\": \"${1|system,user,assistant|}\",",
      "  \"content\": \"${2:Message content here}\"",
      "}"
    ],
    "description": "Insert a single message block"
  },

  "Insert Variable Block": {
    "prefix": "gptp-var",
    "body": [
      "{",
      "  \"name\": \"${1:variableName}\",",
      "  \"description\": \"${2:What this variable does}\",",
      "  \"required\": ${7:true},",
      "  \"example\": \"${4:example value}\"",
      "}"
    ],
    "description": "Insert an input variable definition"
  }
}
