{
  "$doctype": "gptp",
  "schemaVersion": "1.2.0",
  "promptVersion": "1.0.0",
  "title": "Short Test",
  "description": "Minimal valid prompt for extension testing.",
  "system": "You are a helpful assistant.",
  "variables": [
    { "name": "topic", "description": "Subject to explain", "required": true, "example": "AI prompts" }
  ],
  "messages": [
    { "role": "user", "content": "Explain {{topic}} in one sentence." }
  ],
  "output_format": "markdown"
}
