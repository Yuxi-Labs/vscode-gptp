{
  "compilerOptions": {
  "module": "ESNext",
    "target": "ES2022",
  "lib": ["ES2022", "DOM"],
  "types": ["node", "vscode", "mocha"],
    "sourceMap": true,
    "rootDir": "src",
    "outDir": "dist",
    "strict": true,

    /* Module resolution */
  "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "typeRoots": [
      "./src/types",
      "./node_modules/@types"
    ],

    /* Clean up output */
    "noEmitOnError": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true

    /* Uncomment if needed */
    // "noImplicitReturns": true,
    // "noFallthroughCasesInSwitch": true,
    // "noUnusedParameters": true
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist", "out", ".vscode-test"]
}
